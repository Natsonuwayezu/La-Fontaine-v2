1) AS attendance_rate<br>   FROM (attendance a<br>     JOIN classes c ON ((c.id = a.class_id)))<br>  WHERE (a.academic_year_id = ( SELECT academic_years.id<br>           FROM academic_years<br>          WHERE (academic_years.is_active = true)))<br>  GROUP BY a.date, c.name<br>  ORDER BY a.date DESC, c.name; |
