| 👁️ VIEW: session_fee_summary                      | null      | View Definition                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          | null                                                                                                                                                                                                                    | null                                                                                                                                                                                                                                                             | null                                       | null                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |  SELECT sf.id,<br>    sf.student_id,<br>    (((s.first_name): :text \|\| ' ': :text) \|\| (s.last_name): :text) AS student_name,<br>    s.student_code,<br>    sf.session_class_id,<br>    sc.name AS class_name,<br>    sf.fee_category_id,<br>    fc.name AS fee_category_name,<br>    sf.holiday_session_id,<br>    hs.name AS session_name,<br>    sf.academic_year_id,<br>    ay.name AS academic_year,<br>    sf.amount,<br>    sf.paid_amount,<br>    (sf.amount - sf.paid_amount) AS balance,<br>    sf.is_paid,<br>    sf.is_waived,<br>    sf.is_approved,<br>    sf.due_date,<br>    sf.notes,<br>    sf.created_at,<br>    sf.updated_at,<br>    sf.approved_at,<br>    sf.waived_at,<br>    sf.waiver_reason<br>   FROM (((((session_fees sf<br>     LEFT JOIN students s ON ((s.id = sf.student_id)))<br>     LEFT JOIN session_classes sc ON ((sc.id = sf.session_class_id)))<br>     LEFT JOIN fee_categories fc ON ((fc.id = sf.fee_category_id)))<br>     LEFT JOIN holiday_sessions hs ON ((hs.id = sf.holiday_session_id)))<br>     LEFT JOIN academic_years ay ON ((ay.id = sf.academic_year_id)))<br>  ORDER BY sf.created_at DESC;                                                                  |
| 👁️ VIEW: session_fee_totals_by_class              | null      | View Definition                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          | null                                                                                                                                                                                                                    | null                                                                                                                                                                                                                                                             | null                                       | null                                                     