| 👁️ VIEW: attendance_daily_summary                 | null      | View Definition                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          | null                                                                                                                                                                                                                    | null                                                                                                                                                                                                                                                             | null                                       | null                                                     